// 校验是否为ip4地址
function isValidIPv4(ip) {
    // 匹配 0-255 的 IPv4 地址格式
    const ipv4Regex = /^(25[0-5]|2[0-4]\d|1\d{2}|\d{1,2})\.(25[0-5]|2[0-4]\d|1\d{2}|\d{1,2})\.(25[0-5]|2[0-4]\d|1\d{2}|\d{1,2})\.(25[0-5]|2[0-4]\d|1\d{2}|\d{1,2})$/;
    return ipv4Regex.test(ip);
}

